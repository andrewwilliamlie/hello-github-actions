# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL="postgresql://hausjo:hausjo@localhost:5432/hausjo?schema=public"
APP_URL=http://localhost:3000

# 32 random bytes, base64. Generate: openssl rand -base64 32   (NEVER reuse between environments)
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Random string ≥16 chars used to hash OTP codes. Generate: openssl rand -hex 24
OTP_PEPPER=

# auto = Secure cookies only in production. Set true behind HTTPS in staging.
SECURE_COOKIES=auto
ADMIN_MFA_REQUIRED=true

# ─── Storage (local | s3). S3 works with AWS S3, MinIO, R2, Wasabi… ────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=ap-southeast-3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Providers (mock = nothing is sent; refused in production unless ALLOW_MOCK_PROVIDERS=true) ─
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
SMTP_URL=
EMAIL_FROM="Hausjo Agent Network <no-reply@hausjo.example>"
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
ALLOW_MOCK_PROVIDERS=false

# Shows the DEMO banner (use with seeded demo data only)
DEMO_MODE=false
